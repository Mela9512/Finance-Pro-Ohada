{
  "name": "financepro-ohada",
  "version": "1.0.0",
  "private": true,
  "description": "Logiciel SaaS professionnel de comptabilité et gestion conforme au SYSCOHADA révisé",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/frontend run dev",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:backend": "node apps/backend/dist/main.js",
    "build": "npm --prefix packages/shared run build && npm --prefix apps/backend run build && npm --prefix apps/frontend run build",
    "start": "node apps/backend/dist/main.js",
    "lint": "eslint apps/backend/src apps/frontend/src packages/shared/src",
    "test:backend": "npm --prefix apps/backend run test",
    "test:e2e": "npm --prefix apps/backend run test:e2e"
  },
  "keywords": [
    "ohada",
    "syscohada",
    "comptabilite",
    "finance",
    "saas",
    "nestjs",
    "react",
    "typescript"
  ],
  "author": "FinancePro Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.65.0"
  }
}
