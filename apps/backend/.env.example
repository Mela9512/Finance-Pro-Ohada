DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=true

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

CSRF_SECRET=change-me

# En production (Vercel), doit être l'URL EXACTE du frontend déployé (avec https://,
# sans slash final) : c'est à la fois la valeur autorisée par CORS et ce qui détermine
# si les cookies cross-origin (SameSite=None) sont acceptés par le navigateur.
FRONTEND_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# IA (Google Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
